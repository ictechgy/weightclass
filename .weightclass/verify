#!/bin/sh
set -eu

if ! git diff --cached --quiet -- \
  .weightclass/verify \
  tests/test_advisory_evidence_modes.py \
  tests/test_advisory_flexible_vendors.py \
  tests/test_advisory_parallel.py \
  tests/test_advisory_hardening_acceptance.py \
  tests/test_advisory_campaign_lanes.py \
  tests/test_advisory_portfolio.py; then
  echo "protected acceptance files changed"
  exit 1
fi

set +e
WCLASS_CAMPAIGN_ACCEPTANCE=1 PYTHONPATH="$PWD/src" \
  python3 -m unittest \
    tests.test_advisory_evidence_modes \
    tests.test_advisory_flexible_vendors \
    tests.test_advisory_parallel \
    tests.test_advisory_hardening_acceptance \
    tests.test_advisory_campaign_lanes \
    tests.test_advisory_portfolio
focused_code=$?
set -e

if [ "$focused_code" -eq 0 ]; then
  PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$PWD/src" \
    python3 -W error::ResourceWarning -m unittest discover -s tests
  python3 -m compileall -q src tests tools
  exit 0
fi

if [ "$focused_code" -ne 1 ]; then
  exit 1
fi

PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$PWD/src" \
  python3 -W error::ResourceWarning -m unittest discover -s tests
python3 -m compileall -q src tests tools
exit 42
