#!/usr/bin/env python3
"""Prospective evidence gate for repository-grounded improvement designs."""

from __future__ import annotations

import json
import os
import re
import stat
import subprocess
import sys
from pathlib import Path

MAX_RESULT_BYTES = 131_072
MAX_OPTIONS = 8
CITATION = re.compile(r"([A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*):([1-9][0-9]{0,5})")
ROOT_KEYS = frozenset(
    {
        "schema_version",
        "mode",
        "problem",
        "summary",
        "principles",
        "options",
        "recommendation",
        "acceptance_criteria",
        "validation",
        "limitations",
    }
)
OPTION_KEYS = frozenset(
    {"title", "rationale", "evidence", "strengths", "risks", "affected_surfaces"}
)
DIMENSIONS = (
    frozenset({"security", "sandbox", "egress", "credential", "isolation", "privacy"}),
    frozenset({"performance", "latency", "throughput", "parallel", "token", "cost"}),
    frozenset({"product", "workflow", "installation", "integration", "usability", "operator"}),
)


class DesignVerificationError(ValueError):
    """Value-free rejection of an unsupported design result."""


def object_without_duplicates(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, value in pairs:
        if key in result:
            raise DesignVerificationError
        result[key] = value
    return result


def text(value: object, *, minimum: int = 1) -> str:
    if not isinstance(value, str) or not minimum <= len(value.encode("utf-8")) <= 8_192:
        raise DesignVerificationError
    return value


def text_list(value: object, *, minimum: int = 0) -> list[str]:
    if not isinstance(value, list) or not minimum <= len(value) <= 64:
        raise DesignVerificationError
    values = [text(item) for item in value]
    if len(values) != len(set(values)):
        raise DesignVerificationError
    return values


def tracked_file(value: str) -> Path:
    relative = Path(value)
    if relative.is_absolute() or ".." in relative.parts:
        raise DesignVerificationError
    try:
        metadata = relative.lstat()
    except OSError:
        raise DesignVerificationError from None
    if not stat.S_ISREG(metadata.st_mode):
        raise DesignVerificationError
    tracked = subprocess.run(
        ["git", "-c", "core.hooksPath=/dev/null", "ls-files", "--error-unmatch", "--", value],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
        timeout=10,
    )
    if tracked.returncode != 0:
        raise DesignVerificationError
    return relative


def validate_citations(evidence: list[str]) -> None:
    found = []
    for statement in evidence:
        found.extend(CITATION.findall(statement))
    if not found:
        raise DesignVerificationError
    for file_name, line_text in found:
        relative = tracked_file(file_name)
        try:
            lines = relative.read_text(encoding="utf-8").splitlines()
        except (OSError, UnicodeError):
            raise DesignVerificationError from None
        if int(line_text) > len(lines):
            raise DesignVerificationError


def validate_option(value: object) -> tuple[str, str]:
    if not isinstance(value, dict) or set(value) != OPTION_KEYS:
        raise DesignVerificationError
    title = text(value["title"], minimum=8)
    rationale = text(value["rationale"], minimum=24)
    evidence = text_list(value["evidence"], minimum=1)
    strengths = text_list(value["strengths"], minimum=1)
    risks = text_list(value["risks"], minimum=1)
    surfaces = text_list(value["affected_surfaces"], minimum=1)
    validate_citations(evidence)
    for surface in surfaces:
        tracked_file(surface)
    combined = "\n".join((title, rationale, *evidence, *strengths, *risks, *surfaces))
    return title, combined


def validate(payload: object) -> int:
    if not isinstance(payload, dict) or set(payload) != ROOT_KEYS:
        raise DesignVerificationError
    if payload["schema_version"] != 1 or isinstance(payload["schema_version"], bool):
        raise DesignVerificationError
    if payload["mode"] != "design":
        raise DesignVerificationError
    problem = text(payload["problem"], minimum=24)
    summary = text(payload["summary"], minimum=24)
    limitations = text_list(payload["limitations"], minimum=1)
    if limitations == ["baseline_probe"] and "baseline probe" in problem.lower():
        return 42

    principles = text_list(payload["principles"], minimum=3)
    acceptance = text_list(payload["acceptance_criteria"], minimum=4)
    validation = text_list(payload["validation"], minimum=3)
    recommendation = text(payload["recommendation"], minimum=24)
    options = payload["options"]
    if not isinstance(options, list) or not 3 <= len(options) <= MAX_OPTIONS:
        raise DesignVerificationError
    checked = [validate_option(option) for option in options]
    titles = [title for title, _ in checked]
    if len(titles) != len(set(titles)):
        raise DesignVerificationError
    if not any(title.casefold() in recommendation.casefold() for title in titles):
        raise DesignVerificationError

    combined = "\n".join(
        (problem, summary, *principles, *(body for _, body in checked), recommendation, *acceptance)
    ).casefold()
    if any(not any(term in combined for term in dimension) for dimension in DIMENSIONS):
        raise DesignVerificationError
    if not any(character.isdigit() for criterion in acceptance for character in criterion):
        raise DesignVerificationError
    validation_text = "\n".join(validation).casefold()
    if not any(
        term in validation_text for term in ("test", "benchmark", "measure", "pytest", "unittest")
    ):
        raise DesignVerificationError
    return 0


def main() -> int:
    if os.environ.get("WCLASS_ADVISORY_WORKFLOW") != "design":
        return 1
    data = sys.stdin.buffer.read(MAX_RESULT_BYTES + 1)
    if not data or len(data) > MAX_RESULT_BYTES:
        return 1
    try:
        payload = json.loads(
            data.decode("utf-8", errors="strict"),
            object_pairs_hook=object_without_duplicates,
            parse_constant=lambda _value: (_ for _ in ()).throw(DesignVerificationError()),
        )
        return validate(payload)
    except (UnicodeError, ValueError, RecursionError, OSError, subprocess.SubprocessError):
        print("design verification failed")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
